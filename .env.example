# Printloom Configuration — copy to .env and fill in. NEVER commit .env.

# Application
APP_ENV=production
APP_DEBUG=false

# Database (SQLite lives in the runtime-mounted db/ volume)
DATABASE_URL=sqlite:///./db/printloom.db

# MQTT Settings (Bambu Lab)
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_USERNAME=bblp
MQTT_USE_TLS=true

# Klipper/Moonraker Settings
KLIPPER_HOST=
KLIPPER_PORT=7125

# File Upload Settings
MAX_UPLOAD_SIZE=104857600  # 100MB
UPLOAD_DIR=./uploads

# Server Settings
WORKERS=4
LOG_LEVEL=info

# Auto-update (optional) — GitHub Container Registry version check + Watchtower
# Leave GITHUB_TOKEN empty to disable the update check (public repo needs none).
GITHUB_TOKEN=
GITHUB_REPO=DasKlaus00/printloom

# Update channel for the prod compose image tag: latest (stable) or beta.
# You can also switch this live in the web UI (System page).
PRINTLOOM_CHANNEL=latest
PRINTLOOM_IMAGE=ghcr.io/dasklaus00/printloom
PRINTLOOM_CONTAINER=printloom-app
PORT=8000

# Watchtower in-app update button + background auto-update.
# Set WATCHTOWER_TOKEN to your own secret (must match on both compose services).
WATCHTOWER_URL=http://watchtower:8080
WATCHTOWER_TOKEN=change-me-update-token

# NOTE: The marketplace server URL + om4d_ API token are NOT set here.
# They are configured in-app under Configuration -> Marktplatz-Verbindung and
# stored in the runtime-mounted db/ volume, so they never enter the image/git.
